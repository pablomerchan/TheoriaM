# Root .gitignore for repo

# ----- OS -----
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# ----- Python -----
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.eggs/
.eggs/

# Pytest
.pytest_cache/

# Logs and databases
*.log
logs/
*.sqlite3
*.db

# Python env files
.env
.env.*

# ----- Node / Frontend -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Angular / build outputs
/dist/
/build/
/out-tsc/
/tmp/
/.angular/

# Sass cache
.sass-cache/

# ----- IDEs and editors -----
.vscode/
.idea/
.history/

# ----- System files -----
# Thumbs and other OS files
Thumbs.db
.DS_Store

# ----- Misc -----
# Project local settings and sensitive files
/.env
/.env.local
secrets/
credentials/

# Ignore compiled assets and temporary files
*.class
*.pyc
*.pyo
*.pyd
*.so

# Backup files
*~
*.swp
*.swo
*.bkp
.*.bkp

