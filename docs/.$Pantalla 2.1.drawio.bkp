        </mxCell>
        <mxCell id="z4-s0XFXnrqn3CtfrYip-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Landing page&lt;/h1&gt;&lt;p&gt;Landing Page / Inicio: Una introducción impactante con tu propuesta de valor, destacando el concepto de &quot;encontrar la mejor versión de ti&quot;.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="290" x="-1080" y="-235" as="geometry" />
        </mxCell>
        <mxCell id="z4-s0XFXnrqn3CtfrYip-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Servicios de asesoria&lt;/h1&gt;&lt;p&gt;Servicios de Asesoría: Detalle de cómo ayudan a encontrar el estilo personal y la elección de prendas..&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="360" x="-690" y="-232" as="geometry" />
        </mxCell>
        <mxCell id="z4-s0XFXnrqn3CtfrYip-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Test de Estilo Personal&lt;/h1&gt;&lt;p&gt;Una interfaz interactiva para que los usuarios den el primer paso hacia su nuevo look.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="310" x="-670" y="-140" as="geometry" />
        </mxCell>
        <mxCell id="V_QdxHPpVT2KmsjCEpau-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="150" width="120.7" x="689.3" y="280" as="geometry" />
        </mxCell>
        <mxCell id="V_QdxHPpVT2KmsjCEpau-2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;&lt;b class=&quot;whb&quot; style=&quot;-webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; border: 0px; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-stretch: inherit; line-height: inherit; font-family: Helvetica, &amp;quot;Nimbus Sans L&amp;quot;, Arial, &amp;quot;Liberation Sans&amp;quot;, sans-serif; font-optical-sizing: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-size: 16px; vertical-align: baseline; background: none rgb(255, 255, 255); color: rgb(84, 84, 84);&quot;&gt;Identifica la parte más pequeña de la cintura y mídela.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;&amp;nbsp;Generalmente, esta es la parte que se encuentra por debajo de las costillas y a 5 u 8 cm por encima del ombligo. Envuelve la cinta en esta parte del cuerpo y registra la medición en pulgadas o centímetros.&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-family: inherit; font-style: inherit; font-variant-ligatures: inherit; font-variant-caps: inherit; font-weight: inherit; background-color: rgb(255, 255, 255); color: rgb(84, 84, 84); font-size: 16px;&quot;&gt;Asegúrate de que la cinta no esté demasiado ajustada. Es importante que esté ceñida, pero que puedas hacer caber un dedo entre la cinta y la piel.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="205" width="430" x="555" y="450" as="geometry" />
        </mxCell>
