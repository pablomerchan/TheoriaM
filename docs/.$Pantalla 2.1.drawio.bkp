        </mxCell>
        <mxCell id="DOVK9OOCbJd64Sqvz9Xp-209" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
