<mxfile host="app.diagrams.net">
  <diagram name="Relaciones Asesoría" id="relaciones-asesoria">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- tbl_menu_servicios -->
        <mxCell id="M" value="tbl_menu_servicios ID" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- tbl_menu_asesoria -->
        <mxCell id="MA" value="tbl_menu_asesoria" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- tbl_articulo tipo_asesoria -->
        <mxCell id="A1" value="tbl_articulo tipo_asesoria" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- tbl_articulo id_usuario -->
        <mxCell id="A2" value="tbl_articulo id_usuario" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="140" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ARTICULO_MARKER -->
        <mxCell id="Tag" value="&lt;!-- ARTICULO_MARKER --&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Conexiones -->
        <mxCell id="edge1" value="1. Debe existir el ID" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="M" target="MA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge2" value="2. Enlace de Filtro Idéntico" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="MA" target="A1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge3" value="3. Filtro de Usuario Idéntico" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="MA" target="A2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge4" value="4. Debe contener" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="MA" target="Tag">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
